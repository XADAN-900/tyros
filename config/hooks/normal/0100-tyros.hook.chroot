#!/bin/sh
set -e
echo "==> TyrOS yapılandırılıyor"

# --- Apache httpd ---
a2enmod proxy proxy_http proxy_wstunnel headers
a2dissite 000-default || true
a2ensite 000-tyros-deny tyros
# Sadece bu bilgisayardan erişilsin
sed -i 's/^Listen 80$/Listen 127.0.0.1:80/' /etc/apache2/ports.conf
systemctl enable apache2 NetworkManager

chmod 755 /usr/local/bin/tyros-session /usr/local/bin/tyros-logout /usr/local/bin/tyros-close /usr/local/bin/tyros-install /opt/tyros/api/tyros-api.py
chmod -R a+rX /opt/tyros
chmod 755 /usr/local/sbin/tyros-pkg
chmod 0440 /etc/sudoers.d/tyros-pkg
chown root:root /etc/sudoers.d/tyros-pkg

# --- Openbox: arayüz penceresi her zaman altta, çerçevesiz; tek masaüstü ---
python3 - <<'PY'
import re
p = "/etc/xdg/openbox/rc.xml"
s = open(p, encoding="utf-8").read()
rule = """
  <application class="TyrOSShell*">
    <decor>no</decor>
    <position force="yes"><x>0</x><y>0</y></position>
    <layer>below</layer>
    <skip_taskbar>yes</skip_taskbar>
    <skip_pager>yes</skip_pager>
    <focus>yes</focus>
  </application>
</applications>"""
s = s.replace("</applications>", rule, 1)
s = re.sub(r"(<margins>.*?<bottom>)\d+(</bottom>)", r"\g<1>50\2", s, count=1, flags=re.S)
s = re.sub(r"(<desktops>.*?<number>)\d+(</number>)", r"\g<1>1\2", s, count=1, flags=re.S)
s = re.sub(r'(<keybind key="A-F4">\s*)<action name="Close"\s*/>',
           r'\1<action name="Execute"><command>/usr/local/bin/tyros-close</command></action>', s, count=1)
s = re.sub(r"(<theme>\s*<name>)[^<]*(</name>)", r"\1Clearlooks\2", s, count=1)
open(p, "w", encoding="utf-8").write(s)
PY

# --- ttyd (gerçek terminal): Debian 13 deposunda yok, resmi sürümü indir ---
if ! command -v ttyd >/dev/null; then
  curl -fsSL -o /usr/local/bin/ttyd \
    https://github.com/tsl0922/ttyd/releases/download/1.7.7/ttyd.x86_64 \
    && chmod 755 /usr/local/bin/ttyd \
    || { rm -f /usr/local/bin/ttyd; echo "Uyarı: ttyd indirilemedi, basit terminal kullanılacak"; }
fi

# --- Sistem kimliği ---
rm -f /etc/os-release
cat > /etc/os-release <<'OS'
PRETTY_NAME="TyrOS 1.0"
NAME="TyrOS"
VERSION_ID="1.0"
VERSION="1.0 (Debian 13 tabanlı)"
VERSION_CODENAME=trixie
ID=tyros
ID_LIKE=debian
HOME_URL="https://www.debian.org/"
OS
# Konsol açılış yazılarını gizle (ekran temizlenir, doğrudan arayüz açılır)
printf '\033c' > /etc/issue
echo "TyrOS 1.0" > /etc/issue.net

# --- Boyut küçültme (özellikler etkilenmez) ---
# Masaüstü bilgisayarlarda hiç kullanılmayan büyük bellenimler (ağ anahtarı çipi, veri merkezi
# ekran kartı, sunucu ağ kartları, telefon santrali) ve İngilizce konuşma tanıma verisi.
# Başka bir paket bunlara gerçekten bağlıysa dpkg kaldırmayı reddeder; o zaman paket yerinde kalır.
for p in firmware-marvell-prestera firmware-nvidia-tesla-535-gsp firmware-netronome firmware-qlogic \
         firmware-cavium firmware-myricom firmware-netxen dahdi-firmware-nonfree pocketsphinx-en-us; do
  if dpkg -s "$p" >/dev/null 2>&1; then dpkg -r "$p" >/dev/null 2>&1 || echo "Not: $p kaldırılamadı, yerinde bırakıldı"; fi
done
# Belgeler (lisans dosyaları kalır), Türkçe/İngilizce dışındaki çeviriler
find /usr/share/doc -mindepth 1 ! -type d ! -name copyright -delete 2>/dev/null || true
find /usr/share/doc -mindepth 1 -type d -empty -delete 2>/dev/null || true
rm -rf /usr/share/info/* /usr/share/lintian /usr/share/linda 2>/dev/null || true
for d in /usr/share/locale/*/; do
  case "$(basename "$d")" in tr|tr_*|en|en_*) ;; *) rm -rf "$d" ;; esac
done
for d in /usr/share/man/*/; do
  case "$(basename "$d")" in man*|tr|tr_*) ;; *) rm -rf "$d" ;; esac
done
for d in /usr/share/help/*/; do
  case "$(basename "$d")" in C|tr|tr_*|en|en_*) ;; *) rm -rf "$d" ;; esac
done
if [ -f /usr/lib/chromium/locales/en-US.pak ]; then
  find /usr/lib/chromium/locales -name '*.pak' ! -name 'en-US.pak' ! -name 'tr.pak' -delete
fi

# --- Az kaynak, kararlı çalışma ---
# RAM'in yarısı kadar sıkıştırılmış takas (zram): bellek dolunca donma yerine sıkıştırır
if [ -f /etc/default/zramswap ]; then
  sed -i -E 's/^#? *ALGO=.*/ALGO=zstd/; s/^#? *PERCENT=.*/PERCENT=50/; s/^#? *PRIORITY=.*/PRIORITY=100/' /etc/default/zramswap
fi
mkdir -p /etc/systemd/journald.conf.d /etc/sysctl.d
printf '[Journal]\nSystemMaxUse=50M\nRuntimeMaxUse=30M\n' > /etc/systemd/journald.conf.d/tyros.conf
printf 'vm.swappiness=100\nvm.vfs_cache_pressure=50\n' > /etc/sysctl.d/90-tyros.conf

# --- Açılış animasyonu (Plymouth, TyrOS logosu) ---
plymouth-set-default-theme tyros 2>/dev/null || true
update-initramfs -u -k all 2>/dev/null || true

# --- Hızlı açılış: açılışı bekleten gereksiz servisleri kapat ---
systemctl mask NetworkManager-wait-online.service systemd-networkd-wait-online.service \
  apt-daily.timer apt-daily-upgrade.timer man-db.timer e2scrub_all.timer 2>/dev/null || true
systemctl set-default graphical.target
systemctl enable lightdm 2>/dev/null || true

# --- Diske kurulum aracı (Calamares): TyrOS adı ve logosu ---
B=/etc/calamares/branding/debian
if [ -f "$B/branding.desc" ]; then
  sed -i -E \
    -e 's/^( *productName:).*/\1 TyrOS/' \
    -e 's/^( *shortProductName:).*/\1 TyrOS/' \
    -e 's/^( *version:).*/\1 1.0/' \
    -e 's/^( *shortVersion:).*/\1 1.0/' \
    -e 's/^( *versionedName:).*/\1 TyrOS 1.0/' \
    -e 's/^( *shortVersionedName:).*/\1 TyrOS 1.0/' \
    -e 's/^( *bootloaderEntryName:).*/\1 TyrOS/' \
    -e 's/^( *SidebarBackground:).*/\1 "#121827"/' \
    -e 's/^( *SidebarBackgroundCurrent:).*/\1 "#2b2552"/' \
    "$B/branding.desc"
  for img in debian-logo.png welcome.png; do cp /usr/share/tyros/logo.png "$B/$img"; done
fi
# Debian'ın kendi kurulum kısayolunu gizle (TyrOS'unkini kullanıyoruz)
for f in /usr/share/applications/calamares-install-debian.desktop /usr/share/applications/calamares.desktop; do
  if [ -f "$f" ]; then sed -i '/^\[Desktop Entry\]/a NoDisplay=true' "$f"; fi
done
rm -f /etc/xdg/autostart/calamares-desktop-icon.desktop

# Türkçe dil ortamı
sed -i 's/^# *tr_TR.UTF-8/tr_TR.UTF-8/' /etc/locale.gen
locale-gen
