#!/bin/sh
set -e
echo "==> TyrOS yapılandırılıyor"

# --- Apache httpd ---
a2enmod proxy proxy_http proxy_wstunnel headers
a2dissite 000-default || true
a2ensite 000-tyros-deny tyros
# Sadece bu bilgisayardan erişilsin
sed -i 's/^Listen 80$/Listen 127.0.0.1:80/' /etc/apache2/ports.conf
systemctl enable apache2 NetworkManager

chmod 755 /usr/local/bin/tyros-session /usr/local/bin/tyros-logout /usr/local/bin/tyros-close /usr/local/bin/tyros-install /opt/tyros/api/tyros-api.py
chmod -R a+rX /opt/tyros
chmod 755 /usr/local/sbin/tyros-pkg /usr/local/sbin/tyros-mount /usr/local/bin/tyros-key /usr/local/bin/tyros-langpack
chmod 755 /usr/lib/live/config/2000-tyros-nopasswd
# Giriş ekranında "nopasswdlogin" grubundakiler şifresiz girebilsin (yalnızca canlı kullanıcı bu grupta)
if [ -f /etc/pam.d/lightdm ] && ! grep -q nopasswdlogin /etc/pam.d/lightdm; then
  sed -i '/pam_nologin.so/a auth    sufficient      pam_succeed_if.so user ingroup nopasswdlogin' /etc/pam.d/lightdm
fi
chmod 0440 /etc/sudoers.d/tyros-pkg /etc/sudoers.d/tyros-mount
chown root:root /etc/sudoers.d/tyros-pkg /etc/sudoers.d/tyros-mount

# --- Openbox: arayüz penceresi her zaman altta, çerçevesiz; tek masaüstü ---
python3 - <<'PY'
import re
p = "/etc/xdg/openbox/rc.xml"
s = open(p, encoding="utf-8").read()
rule = """
  <application class="TyrOSShell*">
    <decor>no</decor>
    <position force="yes"><x>0</x><y>0</y></position>
    <layer>below</layer>
    <skip_taskbar>yes</skip_taskbar>
    <skip_pager>yes</skip_pager>
    <focus>yes</focus>
  </application>
</applications>"""
s = s.replace("</applications>", rule, 1)
s = re.sub(r"(<margins>.*?<bottom>)\d+(</bottom>)", r"\g<1>50\2", s, count=1, flags=re.S)
s = re.sub(r"(<desktops>.*?<number>)\d+(</number>)", r"\g<1>1\2", s, count=1, flags=re.S)
s = re.sub(r'(<keybind key="A-F4">\s*)<action name="Close"\s*/>',
           r'\1<action name="Execute"><command>/usr/local/bin/tyros-close</command></action>', s, count=1)
s = re.sub(r"(<theme>\s*<name>)[^<]*(</name>)", r"\1Clearlooks\2", s, count=1)
# Klavyedeki ses / parlaklık tuşları ve ekran görüntüsü (Print Screen)
keys = [("XF86AudioRaiseVolume", "vol-up"), ("XF86AudioLowerVolume", "vol-down"), ("XF86AudioMute", "mute"),
        ("XF86MonBrightnessUp", "bright-up"), ("XF86MonBrightnessDown", "bright-down"),
        ("Print", "shot"), ("A-Print", "shot-window"), ("S-Print", "shot-area"), ("W-l", "lock")]
binds = "".join(f'\n  <keybind key="{k}"><action name="Execute"><command>/usr/local/bin/tyros-key {a}</command></action></keybind>'
                for k, a in keys if f'key="{k}"' not in s)
s = s.replace("</keyboard>", binds + "\n</keyboard>", 1)
open(p, "w", encoding="utf-8").write(s)
PY

# --- ttyd (gerçek terminal): Debian 13 deposunda yok, resmi sürümü indir ---
if ! command -v ttyd >/dev/null; then
  curl -fsSL -o /usr/local/bin/ttyd \
    https://github.com/tsl0922/ttyd/releases/download/1.7.7/ttyd.x86_64 \
    && chmod 755 /usr/local/bin/ttyd \
    || { rm -f /usr/local/bin/ttyd; echo "Uyarı: ttyd indirilemedi, basit terminal kullanılacak"; }
fi

# --- Sistem kimliği ---
rm -f /etc/os-release
cat > /etc/os-release <<'OS'
PRETTY_NAME="TyrOS 1.0"
NAME="TyrOS"
VERSION_ID="1.0"
VERSION="1.0 (Debian 13 tabanlı)"
VERSION_CODENAME=trixie
ID=tyros
ID_LIKE=debian
HOME_URL="https://www.debian.org/"
OS
# Konsol açılış yazılarını gizle (ekran temizlenir, doğrudan arayüz açılır)
printf '\033c' > /etc/issue
echo "TyrOS 1.0" > /etc/issue.net

# --- Boyut küçültme (özellikler etkilenmez) ---
# Masaüstü bilgisayarlarda hiç kullanılmayan büyük bellenimler (ağ anahtarı çipi, veri merkezi
# ekran kartı, sunucu ağ kartları, telefon santrali) ve İngilizce konuşma tanıma verisi.
# Başka bir paket bunlara gerçekten bağlıysa dpkg kaldırmayı reddeder; o zaman paket yerinde kalır.
for p in firmware-marvell-prestera firmware-nvidia-tesla-535-gsp firmware-netronome firmware-qlogic \
         firmware-cavium firmware-myricom firmware-netxen dahdi-firmware-nonfree pocketsphinx-en-us; do
  if dpkg -s "$p" >/dev/null 2>&1; then dpkg -r "$p" >/dev/null 2>&1 || echo "Not: $p kaldırılamadı, yerinde bırakıldı"; fi
done
# --- TyrOS ile ilgisi olmayan, menüyü kalabalıklaştıran parçalar ---
# KDE Sistem Ayarları (kurulum aracının yanında gelen), GNOME yardım uygulaması (≈130 MB),
# Openbox ayar aracı (TyrOS düzenini bozabilir), Kylin masaüstünün yetki aracı (lxpolkit yerine geçti)
# Güvenlik: bir paket yalnızca tek başına kaldırılabiliyorsa (başka hiçbir paketi götürmüyorsa) kaldırılır
for p in systemsettings yelp obconf ukui-polkit; do
  if dpkg -s "$p" >/dev/null 2>&1; then
    n=$(apt-get -s purge "$p" 2>/dev/null | grep -c '^Purg' || true)
    if [ "$n" = "1" ]; then apt-get purge -y "$p" || echo "Not: $p kaldırılamadı"
    else echo "Not: $p başka paketlere bağlı, yerinde bırakıldı"; fi
  fi
done
apt-get autoremove --purge -y || true
# Türkçe yazım denetimi (LibreOffice / Firefox) — depoda yoksa derleme durmasın
apt-get install -y --no-install-recommends hunspell-tr 2>/dev/null || echo "Not: hunspell-tr bulunamadı"
# Android telefon/tablet dosyalarına erişim (MTP) ve dokunmatik ekranlar için ekran klavyesi
apt-get install -y --no-install-recommends jmtpfs 2>/dev/null || echo "Not: jmtpfs kurulamadı"
apt-get install -y --no-install-recommends onboard 2>/dev/null || echo "Not: onboard kurulamadı"
for f in onboard onboard-settings; do
  d=/usr/share/applications/$f.desktop
  if [ -f "$d" ] && ! grep -q '^NoDisplay=true' "$d"; then sed -i '/^\[Desktop Entry\]/a NoDisplay=true' "$d"; fi
done
rm -f /etc/xdg/autostart/onboard-autostart.desktop
# Uygulama Mağazası sıralaması: Debian'da en çok kullanılan paketler önce (popcon istatistiği)
mkdir -p /opt/tyros/ui/data
if curl -fsSL --max-time 90 -o /tmp/popcon.gz https://popcon.debian.org/by_inst.gz; then
  zcat /tmp/popcon.gz | awk '$1 ~ /^[0-9]+$/ {print $2}' | head -n 40000 > /opt/tyros/ui/data/popcon.txt || true
else
  echo "Not: popcon indirilemedi, mağaza alfabetik sıralar"
fi
rm -f /tmp/popcon.gz
touch /opt/tyros/ui/data/popcon.txt
chmod -R a+rX /opt/tyros/ui/data
# Apache yalnızca bu bilgisayardaki arayüze hizmet ediyor: az iş parçacığı yeter (bellek tasarrufu)
cat > /etc/apache2/conf-available/tyros-hafif.conf <<'APC'
<IfModule mpm_event_module>
    StartServers             1
    ServerLimit              2
    MinSpareThreads          4
    MaxSpareThreads          20
    ThreadsPerChild          16
    MaxRequestWorkers        32
    MaxConnectionsPerChild   0
</IfModule>
APC
a2enconf tyros-hafif >/dev/null 2>&1 || true
# Her isteği diske yazan genel erişim kaydını kapat (hata kaydı kalır)
a2disconf other-vhosts-access-log >/dev/null 2>&1 || true
# Arka plan araçları ve ayar pencereleri menüde görünmesin (TyrOS'ta karşılıkları var)
for f in htop vim lxterminal thunar thunar-settings thunar-bulk-rename thunar-volman-settings \
         org.xfce.mousepad-settings chromium kdesystemsettings obconf nm-connection-editor synaptic \
         debian-xterm debian-uxterm xterm uxterm; do
  d=/usr/share/applications/$f.desktop
  if [ -f "$d" ] && ! grep -q '^NoDisplay=true' "$d"; then sed -i '/^\[Desktop Entry\]/a NoDisplay=true' "$d"; fi
done
# Güvenlik duvarı: dışarıdan gelen bağlantıları engelle, giden serbest (Ayarlar > Ağ'dan kapatılabilir)
if [ -f /etc/ufw/ufw.conf ]; then
  sed -i 's/^DEFAULT_INPUT_POLICY=.*/DEFAULT_INPUT_POLICY="DROP"/; s/^DEFAULT_OUTPUT_POLICY=.*/DEFAULT_OUTPUT_POLICY="ACCEPT"/' /etc/default/ufw
  sed -i 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf
  systemctl enable ufw 2>/dev/null || true
fi
# Saat eşitleme ve yazıcı servisi
systemctl enable systemd-timesyncd cups 2>/dev/null || true

# Belgeler (lisans dosyaları kalır). Programların tüm dil çevirileri KALIR:
# canlı oturum İngilizce açılır, diske kurulumda hangi dil seçilirse programlar o dilde çalışır.
find /usr/share/doc -mindepth 1 ! -type d ! -name copyright -delete 2>/dev/null || true
find /usr/share/doc -mindepth 1 -type d -empty -delete 2>/dev/null || true
rm -rf /usr/share/info/* /usr/share/lintian /usr/share/linda 2>/dev/null || true

# --- Az kaynak, kararlı çalışma ---
# RAM'in yarısı kadar sıkıştırılmış takas (zram): bellek dolunca donma yerine sıkıştırır
if [ -f /etc/default/zramswap ]; then
  sed -i -E 's/^#? *ALGO=.*/ALGO=zstd/; s/^#? *PERCENT=.*/PERCENT=50/; s/^#? *PRIORITY=.*/PRIORITY=100/' /etc/default/zramswap
fi
mkdir -p /etc/systemd/journald.conf.d /etc/sysctl.d
printf '[Journal]\nSystemMaxUse=50M\nRuntimeMaxUse=30M\n' > /etc/systemd/journald.conf.d/tyros.conf
# zram için önerilen ayarlar: takastan tek tek sayfa oku (sıkıştırılmış bellekte toplu okuma gereksiz),
# bellek sıkışınca ani takılma yerine erken ve küçük adımlarla yer aç
printf 'vm.swappiness=100\nvm.vfs_cache_pressure=50\nvm.page-cluster=0\nvm.watermark_boost_factor=0\nvm.watermark_scale_factor=125\n' > /etc/sysctl.d/90-tyros.conf
# Yazıcı simgesi: TyrOS'ta sistem tepsisi olmadığı için görünmüyor ama arka planda ~30 MB bellek tutuyordu.
# Yazdırma etkilenmez (Ayarlar > Yazıcılar ve uygulamaların yazdır penceresi aynen çalışır).
rm -f /etc/xdg/autostart/print-applet.desktop

# --- Donanıma göre servisler: donanım yoksa servis hiç çalışmaz, takılınca kendiliğinden başlar ---
# Modem servisi: yalnızca 3G/4G modem (ya da USB seri modem) varsa
if [ -f /usr/lib/systemd/system/ModemManager.service ] || [ -f /lib/systemd/system/ModemManager.service ]; then
  mkdir -p /etc/systemd/system/ModemManager.service.d
  cat > /etc/systemd/system/ModemManager.service.d/tyros-hw.conf <<'UNIT'
[Unit]
ConditionPathExistsGlob=|/dev/cdc-wdm*
ConditionPathExistsGlob=|/dev/wwan*
ConditionPathExistsGlob=|/dev/ttyUSB*
ConditionPathExistsGlob=|/dev/ttyACM*
UNIT
  cat > /etc/udev/rules.d/90-tyros-modem.rules <<'UDEV'
# Modem sonradan takılırsa modem servisini başlat
ACTION=="add", SUBSYSTEM=="tty", KERNEL=="ttyUSB*|ttyACM*", TAG+="systemd", ENV{SYSTEMD_WANTS}+="ModemManager.service"
ACTION=="add", SUBSYSTEM=="usbmisc", KERNEL=="cdc-wdm*", TAG+="systemd", ENV{SYSTEMD_WANTS}+="ModemManager.service"
ACTION=="add", SUBSYSTEM=="wwan", TAG+="systemd", ENV{SYSTEMD_WANTS}+="ModemManager.service"
UDEV
fi
# Bluetooth: yalnızca Bluetooth kartı varsa (USB Bluetooth takılınca sistem kendisi başlatır)
if [ -f /usr/lib/systemd/system/bluetooth.service ] || [ -f /lib/systemd/system/bluetooth.service ]; then
  mkdir -p /etc/systemd/system/bluetooth.service.d
  printf '[Unit]\nConditionPathExistsGlob=/sys/class/bluetooth/hci*\n' > /etc/systemd/system/bluetooth.service.d/tyros-hw.conf
fi
# Bellek neredeyse tamamen dolarsa (az RAM'li bilgisayarlar) sistem donmasın:
# en çok bellek kullanan uygulama kapatılır, TyrOS arayüzü ve sistem parçaları korunur
if [ -f /etc/default/earlyoom ]; then
  cat > /etc/default/earlyoom <<'EOOM'
EARLYOOM_ARGS="-m 4 -s 8 -r 0 --avoid ^(Xorg|X|lightdm|openbox|systemd|systemd-.*|dbus-daemon|apache2|python3|ttyd|NetworkManager|pipewire|wireplumber)$ --prefer ^(soffice.bin|firefox-esr|gimp.*|vlc|thunderbird)$"
EOOM
  systemctl enable earlyoom 2>/dev/null || true
fi

# --- Açılış animasyonu (Plymouth, TyrOS logosu) ---
plymouth-set-default-theme tyros 2>/dev/null || true
update-initramfs -u -k all 2>/dev/null || true

# --- Hızlı açılış: açılışı bekleten gereksiz servisleri kapat ---
systemctl mask NetworkManager-wait-online.service systemd-networkd-wait-online.service \
  apt-daily.timer apt-daily-upgrade.timer man-db.timer e2scrub_all.timer 2>/dev/null || true
systemctl set-default graphical.target
systemctl enable lightdm 2>/dev/null || true

# --- Diske kurulum aracı (Calamares): TyrOS adı ve logosu ---
B=/etc/calamares/branding/debian
if [ -f "$B/branding.desc" ]; then
  sed -i -E \
    -e 's/^( *productName:).*/\1 TyrOS/' \
    -e 's/^( *shortProductName:).*/\1 TyrOS/' \
    -e 's/^( *version:).*/\1 1.0/' \
    -e 's/^( *shortVersion:).*/\1 1.0/' \
    -e 's/^( *versionedName:).*/\1 TyrOS 1.0/' \
    -e 's/^( *shortVersionedName:).*/\1 TyrOS 1.0/' \
    -e 's/^( *bootloaderEntryName:).*/\1 TyrOS/' \
    -e 's/^( *SidebarBackground:).*/\1 "#121827"/' \
    -e 's/^( *SidebarBackgroundCurrent:).*/\1 "#2b2552"/' \
    "$B/branding.desc"
  for img in debian-logo.png welcome.png; do cp /usr/share/tyros/logo.png "$B/$img"; done
fi
# Debian'ın kendi kurulum kısayolunu gizle (TyrOS'unkini kullanıyoruz)
for f in /usr/share/applications/calamares-install-debian.desktop /usr/share/applications/calamares.desktop; do
  if [ -f "$f" ]; then sed -i '/^\[Desktop Entry\]/a NoDisplay=true' "$f"; fi
done
rm -f /etc/xdg/autostart/calamares-desktop-icon.desktop

# Dil ortamları: canlı oturum İngilizce, Türkçe de hazır (kurulumda seçilen dil Calamares tarafından eklenir)
sed -i -e 's/^# *tr_TR.UTF-8/tr_TR.UTF-8/' -e 's/^# *en_US.UTF-8/en_US.UTF-8/' /etc/locale.gen
locale-gen
