#!/bin/sh
# TyrOS sürücü yardımcısı: USB bellek / disk bölümünü kullanıcı adına aç (bağla) ya da çıkar.
# udisks izin vermediğinde ya da tanımadığında yedek yol olarak kullanılır (sudoers ile şifresiz).
ACTION="$1"; DEV="$2"; U="${SUDO_USER:-}"
[ -n "$U" ] || { echo "Kullanıcı bilinmiyor" >&2; exit 2; }
case "$DEV" in
  /dev/sd[a-z]|/dev/sd[a-z][0-9]*|/dev/sd[a-z][a-z][0-9]*|/dev/nvme[0-9]n[0-9]p[0-9]*|/dev/mmcblk[0-9]p[0-9]*|/dev/vd[a-z][0-9]*) ;;
  *) echo "Geçersiz aygıt: $DEV" >&2; exit 2 ;;
esac
[ -b "$DEV" ] || { echo "Aygıt bulunamadı" >&2; exit 2; }
UID_=$(id -u "$U"); GID_=$(id -g "$U")
case "$ACTION" in
  mount)
    CUR=$(findmnt -nro TARGET --source "$DEV" 2>/dev/null | head -n1)
    if [ -n "$CUR" ]; then echo "Mounted $DEV at $CUR"; exit 0; fi
    FS=$(blkid -o value -s TYPE "$DEV" 2>/dev/null)
    LABEL=$(blkid -o value -s LABEL "$DEV" 2>/dev/null | tr -cd '[:alnum:] ._-')
    [ -n "$LABEL" ] || LABEL=$(basename "$DEV")
    BASE="/media/$U"
    mkdir -p "$BASE" && chmod 0755 "$BASE"
    MP="$BASE/$LABEL"; n=1
    while mountpoint -q "$MP" 2>/dev/null || { [ -d "$MP" ] && [ -n "$(ls -A "$MP" 2>/dev/null)" ]; }; do
      n=$((n + 1)); MP="$BASE/$LABEL $n"
    done
    mkdir -p "$MP" || exit 5
    OPTS="nosuid,nodev"
    case "$FS" in
      vfat|exfat) mount -t "$FS" -o "$OPTS,uid=$UID_,gid=$GID_,umask=022" "$DEV" "$MP" ;;
      ntfs|ntfs3)
        mount -t ntfs3 -o "$OPTS,uid=$UID_,gid=$GID_,umask=022" "$DEV" "$MP" 2>/dev/null \
          || ntfs-3g -o "uid=$UID_,gid=$GID_,umask=022" "$DEV" "$MP" 2>/dev/null \
          || ntfs-3g -o "ro,uid=$UID_,gid=$GID_,umask=022" "$DEV" "$MP" ;;
      iso9660|udf) mount -o "$OPTS,ro" "$DEV" "$MP" ;;
      ext2|ext3|ext4|btrfs|xfs|f2fs) mount -o "$OPTS" "$DEV" "$MP" ;;
      *) rmdir "$MP" 2>/dev/null; echo "unknown filesystem: ${FS:-yok}" >&2; exit 4 ;;
    esac
    if mountpoint -q "$MP"; then echo "Mounted $DEV at $MP"; exit 0; fi
    rmdir "$MP" 2>/dev/null; echo "Sürücü açılamadı" >&2; exit 5 ;;
  unmount)
    MP=$(findmnt -nro TARGET --source "$DEV" 2>/dev/null | head -n1)
    [ -n "$MP" ] || exit 0
    case "$MP" in /media/*) ;; *) echo "Bu sürücü sistem tarafından kullanılıyor" >&2; exit 3 ;; esac
    sync
    umount "$MP" || { echo "target is busy" >&2; exit 6; }
    rmdir "$MP" 2>/dev/null; exit 0 ;;
  *) echo "Kullanım: tyros-mount mount|unmount /dev/AYGIT" >&2; exit 2 ;;
esac
