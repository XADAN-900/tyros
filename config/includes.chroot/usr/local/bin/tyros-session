#!/bin/bash
# TyrOS grafik oturumu — openbox autostart tarafından başlatılır.
# 1) sistem köprüsü (API)  2) terminal (ttyd)  3) HTML arayüzü (Chromium uygulama modu)
LOG="$HOME/.cache/tyros"
mkdir -p "$LOG" "$HOME/.config/tyros"
xset s off 2>/dev/null
xsetroot -solid '#0b1220' 2>/dev/null
xdg-user-dirs-update 2>/dev/null

# 1) Sistem köprüsü — çökerse kendini yeniden başlatır
( while true; do
    python3 /opt/tyros/api/tyros-api.py >>"$LOG/api.log" 2>&1
    sleep 1
  done ) &

# 2) Gerçek terminal — Apache bunu /term/ adresinde sunar.
#    /run/tyros klasörü www-data grubuna ait ve setgid; böylece ttyd'nin açtığı
#    soket otomatik olarak www-data grubunda olur ve Apache ona bağlanabilir.
if command -v ttyd >/dev/null; then
  ( umask 000
    while true; do
      rm -f /run/tyros/ttyd.sock
      ttyd -i /run/tyros/ttyd.sock -b /term -W \
        -t fontSize=14 -t disableLeaveAlert=true \
        -t 'theme={"background":"#0d1116","foreground":"#d7e0e8","cursor":"#8b7cf0"}' \
        bash -l >>"$LOG/ttyd.log" 2>&1
      sleep 1
    done ) &
fi

# 3) httpd + API hazır olana kadar bekle
for _ in $(seq 1 60); do
  curl -fs -H 'X-TyrOS: 1' http://127.0.0.1/api/ping >/dev/null && break
  sleep 0.5
done

read -r W H < <(xdpyinfo 2>/dev/null | awk '/dimensions:/{split($2,a,"x"); print a[1], a[2]}')

# Arayüz penceresi her zaman tüm ekranı kaplasın: ekran çözünürlüğü değişirse
# (ör. sanal makine penceresi büyütülünce) ya da pencere eksik boyutta açılırsa düzelt.
( while sleep 2; do
    read -r SW SH < <(xdotool getdisplaygeometry 2>/dev/null)
    [ -n "$SH" ] || continue
    best=""; best_area=0
    for wid in $(xdotool search --onlyvisible --class TyrOSShell 2>/dev/null); do
      eval "$(xdotool getwindowgeometry --shell "$wid" 2>/dev/null)" || continue
      area=$(( ${WIDTH:-0} * ${HEIGHT:-0} ))
      if [ "$area" -gt "$best_area" ]; then
        best=$wid; best_area=$area; BW=$WIDTH; BH=$HEIGHT; BX=$X; BY=$Y
      fi
    done
    [ -n "$best" ] || continue
    if [ "$BW" -ne "$SW" ] || [ "$BH" -ne "$SH" ] || [ "$BX" -ne 0 ] || [ "$BY" -ne 0 ]; then
      xdotool windowmove "$best" 0 0 windowsize "$best" "$SW" "$SH" 2>/dev/null
    fi
  done ) &

BROWSER=$(command -v chromium || command -v chromium-browser)
PREF="$HOME/.config/tyros/shell/Default/Preferences"
# Google hizmet anahtarı uyarısını gösterme
export GOOGLE_API_KEY=no GOOGLE_DEFAULT_CLIENT_ID=no GOOGLE_DEFAULT_CLIENT_SECRET=no

# Arayüz penceresi: tam ekran, çerçevesiz, her zaman diğer uygulamaların altında.
# Kapanırsa (ör. Ctrl+W) hemen yeniden açılır.
while true; do
  # Önceki kapanış düzgün değilse çıkan "Sayfalar geri yüklensin mi?" balonunu engelle
  [ -f "$PREF" ] && sed -i -e 's/"exited_cleanly":false/"exited_cleanly":true/' \
    -e 's/"exit_type":"[A-Za-z]*"/"exit_type":"Normal"/' "$PREF"
  "$BROWSER" \
    --class=TyrOSShell \
    --user-data-dir="$HOME/.config/tyros/shell" \
    --app=http://127.0.0.1/ \
    --window-position=0,0 --window-size="${W:-1280},${H:-800}" \
    --no-first-run --no-default-browser-check --noerrdialogs \
    --password-store=basic \
    --overscroll-history-navigation=0 --disable-pinch \
    --hide-crash-restore-bubble --disable-session-crashed-bubble --disable-infobars \
    --disable-features=Translate,TranslateUI,DownloadBubble,DownloadBubbleV2,MediaRouter,GlobalMediaControls,ChromeWhatsNewUI,PrivacySandboxSettings4 \
    --disable-component-update --disable-background-networking --disable-sync --no-pings \
    >>"$LOG/shell.log" 2>&1
  sleep 1
done
